---
import Base from "../layouts/Base.astro";
import LineChart from "../components/LineChart.astro";
import { series } from "../lib/data.js";
import { num, period, signed } from "../lib/format.js";
import fs from "node:fs";
import yaml from "js-yaml";

const spec = yaml.load(fs.readFileSync("../registry/pages/markets.yaml", "utf8"));
const groups = spec.sections.find((s) => s.id === "cross-asset").groups.map((g) => ({
  label: g.label,
  rows: g.series.map((id) => series(id)),
}));
const fmtChange = (s, v) => s.changes?.kind === "bp" ? signed(v, 0, " bp") : signed(v, 2, "%");
const digits = (s) => (s.unit === "inr_per_usd" ? 4 : 2);
---
<Base current="markets" title="Markets & rates">
  <h1>Markets &amp; rates</h1>
  <p class="lede">RBI's policy corridor, money-market and government bond rates, the rupee, equity indices and commodities. Sources: RBI (home page and Weekly Statistical Supplement), FBIL and Yahoo Finance.</p>

  <div class="scroll">
    <table class="data">
      <thead><tr><th>Series</th><th>Latest</th><th>As of</th><th>1-day</th><th>1-week</th><th>YTD</th><th>Note</th></tr></thead>
      <tbody>
        {groups.map((g) => (
          <>
            <tr class="group"><td colspan="7">{g.label}</td></tr>
            {g.rows.map((s) => (
              <tr>
                <td>{s.short_title}</td>
                <td>{num(s.data.at(-1)[1], digits(s))}{s.unit === "percent" ? "%" : ""}</td>
                <td>{period(s.data.at(-1)[0], "D")}</td>
                <td>{fmtChange(s, s.changes?.d1)}</td>
                <td>{fmtChange(s, s.changes?.w1)}</td>
                <td>{fmtChange(s, s.changes?.ytd)}</td>
                <td>{s.data.at(-1)[2]}</td>
              </tr>
            ))}
          </>
        ))}
      </tbody>
    </table>
  </div>
  <p class="chart-sub">Rate changes in basis points; other changes in percent. "–" means the series has no observation close enough to that reference date; snapshot series read from RBI's home page (since 28 Oct 2026) fill in as the site updates each day. Policy rates hold their value until changed, so their changes use the last value in force. Index levels are shown with attribution only and are not offered for download.</p>

  <div class="grid2">
    <LineChart title="Nifty 50" subtitle="Index level, daily close" lines={[{ id: "nifty50_close" }]} years={10} />
    <LineChart title="India VIX" subtitle="Expected 30-day Nifty volatility, %" lines={[{ id: "indiavix_close" }]} years={3} />
    <LineChart title="USD/INR reference rate" subtitle="Rupees per US dollar, FBIL 1 pm fixing" lines={[{ id: "usdinr_ref" }]} years={1} />
    <LineChart title="Brent crude in rupees" subtitle="₹ per barrel (Brent front-month future × FBIL USD/INR)" lines={[{ id: "brent_inr" }]} years={1} />
  </div>
  <p class="chart-sub">Index and futures prices from Yahoo Finance, shown with attribution only. Brent in rupees is a site calculation.</p>
</Base>
