---
import "../styles/global.css";
import { config } from "../lib/config.js";
import { site } from "../lib/data.js";
import { t } from "../lib/i18n.js";
import { period } from "../lib/format.js";
import { topics, more } from "../lib/nav.js";

const { title, description, current } = Astro.props;
const s = site();
const c = config.brand.colors;
// Pages that live under another menu (Data, Methods and Status sit under About).
const active = { data: "about", methods: "about", status: "about" }[current] ?? current;
const pageTitle = title ? `${title} · ${config.site.name}` : config.site.name;
---
<!doctype html>
<html lang={config.site.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description ?? config.site.description} />
    <meta name="robots" content="noindex" />
    <meta name="color-scheme" content="light" />
    <link rel="icon" href="/mark.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={`${config.site.name}: briefings`} href="/briefings/rss.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&family=Literata:wght@400;600&display=swap" rel="stylesheet" />
    <style set:html={`:root{--primary:${c.primary};--accent:${c.accent};--ink:${c.ink};--paper:${c.paper};}`}></style>
  </head>
  <body>
    <header class="site">
      <div class="bar">
        <a class="brand" href="/"><img src="/mark.svg" alt="" /><b>{config.site.name}</b></a>
        {s.as_of && <span class="asof">{t("common.as_of")} {period(s.as_of, "D")}</span>}
        <button class="menu-toggle" aria-expanded="false" aria-controls="site-nav">Menu</button>
        <nav class="main" id="site-nav">
          {[topics, more].map((group, gi) => <>
            {gi === 1 && <span class="sep" aria-hidden="true"></span>}
            {group.map((m) => m.items ? (
              <div class="menu">
                <a href={m.href} class="top" aria-current={active === m.key ? "page" : undefined} aria-haspopup="true">{m.label}<span class="caret">▾</span></a>
                <div class="drop">{m.items.map(([label, href]) => <a href={href}>{label}</a>)}</div>
              </div>
            ) : (
              <div class="menu"><a href={m.href} class="top" aria-current={active === m.key ? "page" : undefined}>{m.label}</a></div>
            ))}
          </>)}
        </nav>
        <button class="search-btn" aria-label="Search (press /)" title="Search (press /)">
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="2"/><path d="M15.5 15.5 21 21" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        </button>
      </div>
    </header>
    <div class="search-modal" hidden>
      <div class="search-box" role="dialog" aria-label="Search">
        <div id="search-ui"></div>
        <p class="search-hint">Esc to close · <a href="/search/">full search page</a></p>
      </div>
    </div>
    <main class="wrap" data-pagefind-body>
      <slot />
    </main>
    <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
    <script is:inline>
      // Header: search overlay (Pagefind, loaded on first open), "/" shortcut, phone menu,
      // and tap-to-open dropdowns on touch screens.
      (() => {
        const modal = document.querySelector(".search-modal");
        let ui = null;
        const open = () => {
          modal.hidden = false;
          if (!ui) {
            const sc = document.createElement("script");
            sc.src = "/pagefind/pagefind-ui.js";
            sc.onload = () => {
              ui = new PagefindUI({ element: "#search-ui", showSubResults: true, showImages: false, resetStyles: false });
              modal.querySelector("input")?.focus();
            };
            document.head.append(sc);
          } else modal.querySelector("input")?.focus();
        };
        const close = () => { modal.hidden = true; };
        document.querySelector(".search-btn").addEventListener("click", open);
        modal.addEventListener("click", (e) => { if (e.target === modal) close(); });
        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape") close();
          if (e.key === "/" && modal.hidden && !/input|textarea/i.test(document.activeElement.tagName)) { e.preventDefault(); open(); }
        });
        const nav = document.getElementById("site-nav"), toggle = document.querySelector(".menu-toggle");
        toggle.addEventListener("click", () => {
          const on = nav.classList.toggle("open");
          toggle.setAttribute("aria-expanded", on);
        });
        // On touch screens the first tap on a menu opens its dropdown; a second tap follows the link.
        document.querySelectorAll(".menu > a.top[aria-haspopup]").forEach((a) => a.addEventListener("click", (e) => {
          const menu = a.parentElement;
          if (matchMedia("(hover: none)").matches || nav.classList.contains("open")) {
            if (!menu.classList.contains("show")) {
              e.preventDefault();
              document.querySelectorAll(".menu.show").forEach((m) => m !== menu && m.classList.remove("show"));
              menu.classList.add("show");
            }
          }
        }));
        document.addEventListener("click", (e) => { if (!e.target.closest(".menu")) document.querySelectorAll(".menu.show").forEach((m) => m.classList.remove("show")); });
      })();
    </script>
    <script>
      // "On this page": a contents line under the first heading, built from the h2 headings.
      const main = document.querySelector("main");
      const heads = [...main.querySelectorAll("h2")].filter((h) => !/^Still to come/.test(h.textContent));
      if (heads.length >= 3) {
        const toc = document.createElement("nav");
        toc.className = "toc";
        toc.setAttribute("data-pagefind-ignore", "");
        toc.append("On this page: ");
        heads.forEach((h, i) => {
          h.id ||= h.textContent.trim().toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "") || `s${i}`;
          const a = document.createElement("a");
          a.href = `#${h.id}`; a.textContent = h.textContent.trim();
          toc.append(a);
        });
        const lede = main.querySelector(".lede") ?? main.querySelector("h1");
        lede?.after(toc);
      }
      // Arriving from a menu link (/page/#section): scroll once charts have drawn.
      if (location.hash) addEventListener("load", () => document.getElementById(location.hash.slice(1))?.scrollIntoView());
    </script>
    <footer class="site">
      <div class="wrap">
        <p>{config.site.tagline}. Every number is drawn from official public sources; see <a href="/data/">Data</a> for sources and licences.</p>
        <p>{config.credit.inspired_by_text} <a href={config.credit.inspired_by_url}>{config.credit.inspired_by_url.replace("https://", "")}</a></p>
        <p>Private preview, built {period(s.built_on, "D")}. <a href="/status/">{t("nav.status")}</a> · <a href="/privacy/">Terms and privacy</a></p>
      </div>
    </footer>
  </body>
</html>
