---
// Newsletter signup box. Renders nothing until site.config.yaml newsletter.enabled is true
// and newsletter.buttondown_username is set. The form posts to /api/subscribe (a Cloudflare
// Pages Function, functions/api/subscribe.js), which adds the reader through Buttondown's
// API; Buttondown then emails them a confirmation link (double opt-in). The reader stays
// on the page and sees a closable message with the real result.
import { config } from "../lib/config.js";
const n = config.newsletter ?? {};
const id = `nl-${Math.random().toString(36).slice(2, 8)}`;
const email = config.contact?.feedback_email ?? "";
---
{n.enabled && n.buttondown_username && (
  <div class="signup-wrap" data-signup={id}>
    <form class="signup" action="/api/subscribe" method="post" novalidate>
      <label for={`${id}-email`}>Every morning: a short email on India's economy, written by AI from the data on this site, with every number checked against the source.</label>
      <input id={`${id}-email`} type="email" name="email" placeholder="you@example.com" required autocomplete="email" />
      <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" class="signup-hp" />
      <button type="submit">Subscribe</button>
    </form>
    <div class="signup-done" role="status" hidden>
      <span class="signup-msg"></span>
      <button type="button" class="signup-close" aria-label="Close">×</button>
    </div>
  </div>
)}
<script define:vars={{ email }}>
  document.querySelectorAll("[data-signup]").forEach((wrap) => {
    if (wrap.dataset.ready) return;
    wrap.dataset.ready = "1";
    const form = wrap.querySelector("form"), done = wrap.querySelector(".signup-done");
    const msg = wrap.querySelector(".signup-msg"), button = form.querySelector("button");
    const input = form.querySelector('input[type="email"]');
    const fallback = `Something went wrong. Please try again${email ? `, or write to ${email}` : ""}.`;
    const show = (ok, text) => {
      button.disabled = false; button.textContent = "Subscribe";
      done.classList.toggle("signup-error", !ok);
      msg.textContent = text;
      done.hidden = false;
      if (ok) { form.hidden = true; form.reset(); }
    };
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (!input.checkValidity()) { show(false, "Please enter a valid email address."); return; }
      button.disabled = true; button.textContent = "Subscribing…";
      try {
        const r = await fetch(form.action, { method: "POST", body: new FormData(form) });
        const res = await r.json().catch(() => ({}));
        if (res.ok && res.status === "exists") show(true, "✓ You're already signed up. If you haven't confirmed yet, look for the confirmation email from Buttondown (check spam too).");
        else if (res.ok) show(true, "✓ Almost done: check your inbox (and spam folder) for a confirmation email from Buttondown and click the link in it.");
        else show(false, res.error || fallback);
      } catch {
        show(false, fallback);
      }
    });
    wrap.querySelector(".signup-close").addEventListener("click", () => {
      done.hidden = true; form.hidden = false;
    });
  });
</script>
